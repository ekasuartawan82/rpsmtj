/test-*.ts
/test-*.mjs

# PHP dependencies & vendor
/php-integration/wordpress-plugin/prodi-poltrada-rps/vendor/
/php-integration/wordpress-plugin/prodi-poltrada-rps/*.zip

# Root archive files & scratch extraction
/Archive.zip
/Archive_extracted/

